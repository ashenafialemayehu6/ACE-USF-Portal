rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ACE-USF owner admin for the Spark plan.
    function isAdmin() {
      return signedIn()
        && request.auth.uid == "Ya2V98lprcVm9HZvLiB0b6Ax8xj1";
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validMeetingAccessRequest(requestId) {
      let programPath = /databases/$(database)/documents/siteContent/meetingPrograms/items/$(request.resource.data.programId);
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let memberPath = /databases/$(database)/documents/meetingRoomMembers/$(request.auth.uid);
      return signedIn()
        && request.resource.data.keys().hasAll([
          "uid", "requesterName", "requesterEmail", "universityName", "fellowshipRole", "programId", "programTitle",
          "audience", "requestedDepartment", "profileSex", "departmentGroup",
          "eligibilityConfirmed", "status", "adminNote", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "requesterName", "requesterEmail", "universityName", "fellowshipRole", "programId", "programTitle",
          "audience", "requestedDepartment", "profileSex", "departmentGroup",
          "eligibilityConfirmed", "status", "adminNote", "createdAt", "updatedAt", "telegramChatId"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.programId is string
        && request.resource.data.programId.size() > 0
        && requestId == request.auth.uid + "_" + request.resource.data.programId
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterName.size() <= 150
        && request.resource.data.requesterEmail is string
        && request.resource.data.requesterEmail.size() <= 200
        && request.resource.data.universityName is string
        && request.resource.data.universityName.size() <= 160
        && request.resource.data.fellowshipRole in [
          "Current student", "Campus fellowship leader", "Church servant",
          "Students’ family", "Alumnus / graduate", "Other fellowship member"
        ]
        && (!request.resource.data.keys().hasAny(["telegramChatId"])
          || (exists(profilePath)
            && request.resource.data.telegramChatId is string
            && request.resource.data.telegramChatId.size() <= 24
            && get(profilePath).data.telegramChatId == request.resource.data.telegramChatId))
        && request.resource.data.programTitle is string
        && request.resource.data.programTitle.size() <= 200
        && request.resource.data.audience in ["department", "departmentGroup", "leaders", "women"]
        && request.resource.data.requestedDepartment is string
        && request.resource.data.requestedDepartment.size() > 0
        && request.resource.data.requestedDepartment.size() <= 150
        && request.resource.data.profileSex in ["female", "male"]
        && request.resource.data.departmentGroup is string
        && request.resource.data.departmentGroup.size() <= 80
        && request.resource.data.eligibilityConfirmed == true
        && request.resource.data.status == "pending"
        && request.resource.data.adminNote == ""
        && exists(programPath)
        && exists(profilePath)
        && get(programPath).data.published == true
        && get(programPath).data.audience == request.resource.data.audience
        && get(profilePath).data.department is string
        && get(profilePath).data.department.size() > 0
        && request.resource.data.requestedDepartment == get(profilePath).data.department
        && request.resource.data.profileSex == get(profilePath).data.sex
        && (request.resource.data.audience != "department"
          || get(programPath).data.department == get(profilePath).data.department)
        && (request.resource.data.audience != "women"
          || get(profilePath).data.sex == "female")
        && (!exists(memberPath)
          || get(memberPath).data.active != true
          || !get(memberPath).data.keys().hasAny(["department"])
          || get(memberPath).data.department == get(profilePath).data.department)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function canEnterMeeting(eventId) {
      let eventPath = /databases/$(database)/documents/siteContent/meetingPrograms/items/$(eventId);
      let membershipPath = /databases/$(database)/documents/meetingRoomMembers/$(request.auth.uid);
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isAdmin()
        || (signedIn()
          && exists(eventPath)
          && get(eventPath).data.published == true
          && (
            get(eventPath).data.audience == "all"
            || (get(eventPath).data.audience == "department"
              && exists(membershipPath)
              && get(membershipPath).data.active == true
              && exists(profilePath)
              && get(profilePath).data.department.size() > 0
              && get(profilePath).data.department == get(eventPath).data.department
              && get(membershipPath).data.department == get(eventPath).data.department)
            || (get(eventPath).data.audience == "departmentGroup"
              && exists(membershipPath)
              && get(membershipPath).data.active == true
              && exists(profilePath)
              && get(profilePath).data.department.size() > 0
              && get(membershipPath).data.department == get(profilePath).data.department
              && get(membershipPath).data.departmentGroup == get(eventPath).data.departmentGroup)
            || (get(eventPath).data.audience == "leaders"
              && exists(membershipPath)
              && get(membershipPath).data.active == true
              && exists(profilePath)
              && get(profilePath).data.department.size() > 0
              && get(membershipPath).data.department == get(profilePath).data.department
              && get(membershipPath).data.leadersOnly == true)
            || (get(eventPath).data.audience == "women"
              && exists(membershipPath)
              && get(membershipPath).data.active == true
              && exists(profilePath)
              && get(profilePath).data.department.size() > 0
              && get(profilePath).data.sex == "female"
              && get(membershipPath).data.womenMinistry == true
              && get(membershipPath).data.sex == "female")
          ));
    }

    function validProfile(data) {
      return data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 100
        && data.email is string
        && data.campus is string
        && data.campus.size() <= 150
        && data.department is string
        && data.department.size() <= 150
        && (!data.keys().hasAny(["sex"]) || data.sex in ["female", "male"])
        && data.telegram is string
        && data.telegram.size() <= 100
        && data.bio is string
        && data.bio.size() <= 1500
        && data.photoURL is string
        && data.photoURL.size() <= 2048;
    }

    function validForumAuthor(author) {
      return author == "Fellowship Member"
        || (
          request.auth.token.keys().hasAny(["email"])
          && author == request.auth.token.email
        )
        || (
          request.auth.token.keys().hasAny(["name"])
          && author == request.auth.token.name
        );
    }

    match /userProfiles/{uid} {
      // Members read their own profile; the owner admin can read all profiles.
      allow read: if owns(uid) || isAdmin();

      allow create: if owns(uid)
        && request.resource.data.keys().hasAll([
          "uid", "displayName", "email", "campus", "department",
          "telegram", "bio", "photoURL", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "email", "campus", "department",
          "sex", "telegram", "bio", "photoURL", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Members may edit their own profile fields, but not their UID or email.
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName", "campus", "department", "sex", "updatedAt"
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && validProfile(request.resource.data)
          && request.resource.data.updatedAt == request.time
        ) || (
          owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName", "campus", "telegram", "bio", "photoURL",
            "telegramLinkCode", "telegramLinkExpiresAt", "updatedAt"
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && validProfile(request.resource.data)
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if isAdmin();
    }

    // Published content is public to read; only the owner admin can change it.
    match /siteContent/{section}/items/{itemId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Only an administrator may verify member departments or grant leader access.
    // A member may read only their own verified access record.
    match /meetingRoomMembers/{uid} {
      allow read: if isAdmin() || owns(uid);
      allow create, update, delete: if isAdmin();
    }

    // Members may submit a pending request for their own UID and read its status.
    // Only the administrator may approve, reject, or delete requests.
    match /meetingAccessRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validMeetingAccessRequest(requestId);
      allow update, delete: if isAdmin();
    }

    // Meeting links and access instructions are stored separately from public program cards.
    // Firebase Rules check the signed-in member's department/campus or leader roster before disclosure.
    match /meetingProgramSecrets/{eventId} {
      allow read: if canEnterMeeting(eventId);
      allow create, update, delete: if isAdmin();
    }

    // Signed-in members can read and create forum posts.
    // Only the owner admin can delete posts; posts cannot be edited.
    match /forum_posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "author", "content", "category", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "authorUid", "uid", "author", "content", "category", "createdAt"
        ])
        && (
          !request.resource.data.keys().hasAny(["authorUid"])
          || request.resource.data.authorUid == request.auth.uid
        )
        && (
          !request.resource.data.keys().hasAny(["uid"])
          || request.resource.data.uid == request.auth.uid
        )
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 100
        && validForumAuthor(request.resource.data.author)
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 3000
        && request.resource.data.category in [
          "general", "prayer", "academic"
        ]
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Private system records.
    match /_system/{document=**} {
      allow read, write: if false;
    }

    // Deny access to every document path not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
