rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Match the owner UID used by Firestore Rules and the admin dashboard.
      return signedIn()
        && request.auth.uid == "Ya2V98lprcVm9HZvLiB0b6Ax8xj1";
    }

    // Signed-in users can view profile photos.
    // Each user can upload or update only their own photo.
    match /profilePhotos/{uid}/{fileName} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        );

      allow delete: if signedIn()
        && (request.auth.uid == uid || isAdmin());
    }

    // Public media and documents can be managed by admins.
    match /siteAssets/{allPaths=**} {
      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.size <= 1024 * 1024 * 1024
        && request.resource.contentType.matches(
          '(application/pdf|audio/.*|image/(jpeg|png|webp))'
        );

      allow delete: if isAdmin();
    }

    // Deny access to all other files.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
